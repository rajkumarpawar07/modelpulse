# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# Database & data
# The committed data/modelpulse.db IS the persistence layer: the daily
# workflow commits it back so history accumulates and the deployed
# dashboard always has fresh data. Only the SQLite side-files are ignored.
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*-test.db
dashboard/data/*.db-journal
dashboard/data/*.db-wal
dashboard/data/*.db-shm
raw/
!raw/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

