# ============================================================================
# ModelPulse — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env. It is in .gitignore.
# ============================================================================

# Bright Data API key
# Get it from: https://brightdata.com/cp/setting
# Must be the SAME key that bdata login uses locally.
BRIGHT_DATA_API_KEY=

# Optional: comma-separated vendor names to scrape.
# Leave empty to scrape ALL collectors in collectors.json.
# Example: VENDOR_FILTER=openai,anthropic,mistral
VENDOR_FILTER=

# Days of history to diff against (default 7)
DIFF_WINDOW_DAYS=7

# Path to SQLite database (relative to project root)
DATABASE_PATH=./data/modelpulse.db

# Slack incoming webhook URL (https://api.slack.com/messaging/webhooks)
# Leave empty to disable Slack alerts and log only.
SLACK_WEBHOOK_URL=

# Discord webhook URL (https://discord.com/developers/docs/resources/webhook)
# Leave empty to disable Discord alerts.
DISCORD_WEBHOOK_URL=

# Minimum number of new changes in a window to trigger an alert.
# 1 = alert on every change. 3 = only when 3+ new changes ship in the window.
ALERT_THRESHOLD=1

# When true, treat deprecated/removed as breaking in alert formatting.
ALERT_BREAKING_ONLY=false

# Generic webhook URL (Zapier "Catch Hook", Make, n8n, or your own endpoint).
# Receives structured JSON alerts — see examples/webhook-payload.json
WEBHOOK_URL=

# When true, alerts fire ONLY for changes matching your keyword watches
# (manage watches with: npm run watch -- add|remove|list)
ALERT_WATCH_ONLY=false

# Ingest GitHub Releases for collectors that declare "github_repo" (default on).
ENABLE_GITHUB=true
